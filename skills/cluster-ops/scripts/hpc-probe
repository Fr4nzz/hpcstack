#!/usr/bin/env python3
"""hpc-probe: drive an interactive allocation from an agent, one tool call per action.

UNTESTED on a real cluster: tested only with fake bsub, srun, bjobs, bkill, squeue and scancel in a private tmux
socket (tests/test_hpc_probe.py).

Usage (on the login node, in the run folder):
  hpc-probe start NAME [--timeout S] -- bsub -Is -q QUEUE -W 2:00 [other bsub options]
  hpc-probe start NAME [--timeout S] -- srun --pty --time=02:00:00 [other srun options]
  hpc-probe run   NAME [--timeout S] [--tail N] -- 'shell command'
  hpc-probe wait  NAME [--timeout S]
  hpc-probe stop  NAME
  hpc-probe attach NAME

start   Give scheduler options only. hpc-probe appends the hpc-session (bsub) or hpc-session-slurm (srun) next to
        this script as the command, and adds the job name hpc-probe-NAME-<random>. It refuses an empty, malformed
        or used NAME, a missing -Is/--pty or walltime, -J/--job-name, any option it does not know (long srun
        options may always be written --option=value), and any word that is not an option or an option's value,
        so no other program can become the allocation's command. Creates the tmux session NAME whose own command
        is the allocation, with no login shell under it: keys sent while the job pends, after a rejection or
        after the end never reach a login-node shell. Records the session id, pane id and pane pid, and from then
        on talks only to that pane, after checking all three. The allocation gets the environment and folder of
        this call, minus secret-looking variables (names with a TOKEN, SECRET, PASSWORD, PASSWD, CREDENTIAL or
        COOKIE part, or ending in _KEY, _PASS or _PWD; LSF_*, LSB_* and SLURM_* are always kept). start prints
        the names it left out. The saved environment file is mode 0600 and is deleted as soon as the launcher
        reads it. Re-sends a readiness echo until the job's shell answers with a numeric job id and a host other
        than this login node. Saves the state and prints it.
run     Refuses a probe that is not ready, a missing or replaced session and a probe whose previous command has not
        ended. Writes the command to N.sh in the probe's own folder (mode 0700, files 0600, never through a link)
        and sources it in the job's shell as an `if` condition, with output to N.log and stdin from /dev/null. So a
        `#`, an unclosed quote or a syntax error cannot swallow the marker, and `set -e` or a failing command
        cannot end the job's shell. After each command, `set -e`, `-u`, `pipefail` and an ERR trap are reset.
        Variables, `cd` and `module load` persist. Prints the log tail and exits with the command's exit code.
        Commands and logs are kept: never type a token into a command, read it from a file instead. Commands
        longer than 540 s belong in a batch job.
wait    Keeps waiting after a start or run timeout, or after a tool call was cut off. Same exit codes.
stop    Interrupts a running command and sends `exit`. Then it looks the job up by its job name and owner in
        bjobs or squeue, from the same scheduler setup as start (LSF_ENVDIR, SLURM_CONF, SLURM_CLUSTERS). Only
        DONE/EXIT (LSF) and COMPLETED, FAILED, CANCELLED, TIMEOUT, OUT_OF_MEMORY, NODE_FAIL, BOOT_FAIL, DEADLINE,
        PREEMPTED (SLURM), or no row at all, count as ended. Held and requeued states count as live. A live job
        with the recorded id is killed after 30 s, by that id. Any other answer (a row it cannot parse, an
        unknown state, a different scheduler setup) keeps the pane and the state and exits 1. Once the job has
        ended it closes the tmux session (just the probe's pane if someone added panes).
attach  Prints the read-only attach command for a person who wants to watch.

Exit codes: run and wait return the command's own code. Otherwise 0 ok, 1 stop could not confirm the end,
2 refused (name, arguments, state), 3 the tmux session or pane is no longer the one start created (nothing was
sent), 124 timeout (the probe stays as it was: inspect, then wait or stop), 125 the allocation or session is gone
(rejected, released by the watchdog, walltime, exit). The last line of every call starts with "hpc-probe:" and
says which case it was: "command N exit R" means R is the command's own code.

Settings (environment): HPC_PROBE_DIR (state, commands and logs, default ~/.hpc-probe, which compute nodes must
be able to read), HPC_PROBE_TMUX (tmux command, default "tmux"), HPC_PROBE_POLL (seconds between pane checks,
default 2), HPC_PROBE_RESEND (seconds between readiness echoes, default 15), HPC_PROBE_STOP_GRACE (seconds stop
waits after `exit` before it kills, default 30).
"""
import fcntl
import json
import math
import os
import pwd
import re
import secrets
import shlex
import shutil
import signal
import socket
import stat
import subprocess
import sys
import time

MAX_WAIT = 540
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
SECRET_PARTS = {"TOKEN", "TOKENS", "SECRET", "SECRETS", "PASSWORD", "PASSWD", "CREDENTIAL", "CREDENTIALS", "COOKIE",
                "APIKEY"}
WRAPPER = {"lsf": "hpc-session", "slurm": "hpc-session-slurm"}
# Scheduler options hpc-probe accepts, by whether they take a value. Anything else is refused.
OPTS = {
    "lsf": {"value": {"-q", "-n", "-M", "-R", "-W", "-We", "-o", "-oo", "-e", "-eo", "-gpu", "-P", "-G", "-m", "-Jd",
                      "-sp", "-wa", "-wt", "-cwd", "-env", "-app", "-U", "-u", "-w", "-E", "-Ep", "-c", "-L",
                      "-outdir", "-g", "-sla", "-C", "-D", "-F", "-S", "-v", "-t", "-b", "-ptl", "-k", "-mig", "-Lp",
                      "-data", "-ext"},
            "flag": {"-Is", "-I", "-Ip", "-IS", "-ISs", "-ISp", "-IX", "-tty", "-H", "-B", "-N", "-x", "-r", "-rn",
                     "-K", "-XF", "-hl"}},
    "slurm": {"value": {"-p", "-t", "-c", "-n", "-N", "-G", "-A", "-q", "-w", "-x", "-C", "-D", "-o", "-e", "-i",
                        "--time", "--partition", "--account", "--qos", "--mem", "--mem-per-cpu", "--cpus-per-task",
                        "--ntasks", "--nodes", "--gres", "--gpus", "--constraint", "--chdir", "--reservation",
                        "--nodelist", "--exclude", "--export"},
              "flag": {"--pty", "--exclusive", "--x11", "--quiet", "--verbose", "--unbuffered", "--label",
                       "--overcommit", "--no-kill", "-Q", "-v", "-u", "-l", "-O"}}}
ENDED = {"lsf": {"DONE", "EXIT"},
         "slurm": {"COMPLETED", "FAILED", "CANCELLED", "TIMEOUT", "OUT_OF_MEMORY", "NODE_FAIL", "BOOT_FAIL", "DEADLINE",
                   "PREEMPTED"}}
LIVE = {"lsf": {"PEND", "PSUSP", "RUN", "USUSP", "SSUSP", "WAIT", "PROV"},
        "slurm": {"PENDING", "RUNNING", "CONFIGURING", "COMPLETING", "SUSPENDED", "REQUEUED", "REQUEUE_HOLD",
                  "REQUEUE_FED", "SPECIAL_EXIT", "RESIZING", "STOPPED", "SIGNALING", "STAGE_OUT", "RESV_DEL_HOLD",
                  "POWER_UP_NODE", "UPDATE_DB"}}
CONTEXT_VARS = ("LSF_ENVDIR", "LSF_SERVERDIR", "SLURM_CONF", "SLURM_CLUSTERS")
STATE_DIR = os.path.abspath(os.path.expanduser(os.environ.get("HPC_PROBE_DIR", "~/.hpc-probe")))
TMUX = shlex.split(os.environ.get("HPC_PROBE_TMUX", "tmux"))
POLL = float(os.environ.get("HPC_PROBE_POLL", "2"))
RESEND = float(os.environ.get("HPC_PROBE_RESEND", "15"))
STOP_GRACE = float(os.environ.get("HPC_PROBE_STOP_GRACE", "30"))
OK, NOT_CONFIRMED, REFUSED, CHANGED, TIMEOUT, GONE = 0, 1, 2, 3, 124, 125
SECURE = os.O_NOFOLLOW | os.O_CLOEXEC


def secret_name(k):
    u = k.upper()
    if u in ("PWD", "OLDPWD") or u.startswith(("LSF_", "LSB_", "SLURM_")):
        return False
    return bool(SECRET_PARTS & set(u.split("_"))) or u.endswith(("_KEY", "_PASS", "_PWD"))


def done(code, msg):
    print(f"hpc-probe: {msg}", flush=True)
    sys.exit(code)


def tmux(*args, check=False):
    r = subprocess.run(TMUX + list(args), capture_output=True, text=True)
    if check and r.returncode:
        done(REFUSED, f"tmux {args[0]} failed: {r.stderr.strip()}")
    return r


def has_session(name):
    return tmux("has-session", "-t", f"={name}").returncode == 0


def owner():
    return pwd.getpwuid(os.getuid()).pw_name


# ---------------------------------------------------------------- private files
def private_dir(path, create=False):
    """An fd for a directory of ours, mode 0700, reached without following a link at the last step."""
    if create:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        try:
            os.mkdir(path, 0o700)
        except FileExistsError:
            pass
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | SECURE)
    except OSError as e:
        done(REFUSED, f"{path} is not a private folder of yours ({e.strerror})")
    s = os.fstat(fd)
    if s.st_uid != os.getuid() or not stat.S_ISDIR(s.st_mode):
        done(REFUSED, f"{path} is not owned by you")
    if stat.S_IMODE(s.st_mode) != 0o700:
        os.fchmod(fd, 0o700)
    return fd


def write_new(dir_fd, name, text, mode=0o600):
    """Create a new file (never an existing file or a link) and write text to it."""
    try:
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | SECURE, mode, dir_fd=dir_fd)
    except OSError as e:
        done(REFUSED, f"cannot create {name} safely ({e.strerror}). Nothing was sent")
    os.fchmod(fd, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)


def read_private(dir_fd, name):
    try:
        fd = os.open(name, os.O_RDONLY | SECURE, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, errors="replace") as f:
        return f.read()


# ---------------------------------------------------------------- state
def state_path(name):
    return os.path.join(STATE_DIR, name + ".json")


def state_dir_fd():
    return private_dir(STATE_DIR, create=True)


def load(name):
    try:
        with open(state_path(name)) as f:
            return json.load(f)
    except FileNotFoundError:
        return None


def save(st):
    path = state_path(st["name"])
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC | SECURE, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(st, f, indent=1)
    os.replace(path + ".tmp", path)


def drop_env(st):
    try:
        os.unlink(state_path(st["name"]) + ".env")
    except FileNotFoundError:
        pass


def lock(name):
    os.close(state_dir_fd())
    fd = os.open(os.path.join(STATE_DIR, name + ".lock"), os.O_CREAT | os.O_RDWR | SECURE, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        done(REFUSED, f"another hpc-probe call is using {name}")
    return fd


def check_name(name):
    if not NAME_RE.match(name or ""):
        done(REFUSED, f"refused name {name!r}: use 1 to 64 letters, digits, '-' or '_', starting with a letter or digit")


def bounded(t):
    if not math.isfinite(t) or t <= 0 or t > MAX_WAIT:
        done(REFUSED, f"--timeout must be a number from 1 to {MAX_WAIT} s. Longer work belongs in a batch job")
    return t


def short(host):
    return host.split(".")[0].lower()


def marker(st, kind):
    return f"__HPCP_{st['token']}_{kind}"


# ---------------------------------------------------------------- the probe's own pane
def identity(st):
    """'ok' when the recorded pane still exists with the recorded session id, pane pid and session name,
    'gone' when neither it nor a session of that name exists, 'changed' otherwise."""
    # list every pane and look for ours: display-message -t with a missing target silently falls back to another
    r = tmux("list-panes", "-a", "-F", "#{pane_id} #{session_id} #{pane_pid} #{session_name}")
    rows = [line.split(" ", 3) for line in r.stdout.splitlines()] if r.returncode == 0 else []
    mine = [x for x in rows if x[0] == st["pane_id"]]
    if not mine:
        return "changed" if has_session(st["name"]) else "gone"
    return "ok" if mine[0] == [st["pane_id"], st["session_id"], str(st["pane_pid"]), st["name"]] else "changed"


def ensure(st):
    """Exit unless the recorded pane is still the probe's own. Called before every send and capture."""
    ident = identity(st)
    if ident == "gone":
        gone(st, "tmux session closed")
    if ident == "changed":
        st["status"] = "changed"
        save(st)
        done(CHANGED, f"{st['name']}: the tmux session or pane is no longer the one start created. Sent nothing. "
                      f"`hpc-probe stop {st['name']}` releases the job without touching that session")


def pane(st):
    ensure(st)
    r = tmux("capture-pane", "-p", "-J", "-t", st["pane_id"], "-S", "-3000")
    return r.stdout.splitlines() if r.returncode == 0 else None


def send(st, text):
    ensure(st)
    tmux("send-keys", "-t", st["pane_id"], "-l", text, check=True)
    tmux("send-keys", "-t", st["pane_id"], "Enter", check=True)


def scan(st, lines, pattern):
    """Last match of a whole-line pattern, plus the allocation's exit code if it ended."""
    hit = ended = None
    for line in lines:
        line = line.rstrip()
        m = re.fullmatch(pattern, line)
        if m:
            hit = m
        e = re.fullmatch(re.escape(marker(st, "ALLOC_ENDED_")) + r"(-?\d+)", line)
        if e:
            ended = int(e.group(1))
    return hit, ended


def gone(st, why):
    st["status"] = "ended"
    save(st)
    drop_env(st)
    done(GONE, f"{st['name']}: allocation or session is gone ({why}). Run `hpc-probe stop {st['name']}`, which "
               f"checks the scheduler")


# ---------------------------------------------------------------- start
def allocation(argv):
    """(scheduler, error). argv is the scheduler and its options only: every word must be a known option or the
    value of one, so no other program can become the allocation's command."""
    if not argv:
        return None, "give the scheduler and its options after --, e.g. -- bsub -Is -q normal -W 2:00"
    sched = {"bsub": "lsf", "srun": "slurm"}.get(os.path.basename(argv[0]))
    if not sched:
        return None, "the allocation must be bsub or srun (options only: hpc-probe adds the hpc-session command)"
    seen, i, args = set(), 1, argv[1:]
    opts = OPTS[sched]
    while i <= len(args):
        a = args[i - 1]
        if sched == "slurm" and a.startswith("--") and "=" in a:
            seen.add(a.split("=", 1)[0])
        elif a in opts["flag"]:
            seen.add(a)
        elif a in opts["value"]:
            if i == len(args) or args[i].startswith("-") and not re.fullmatch(r"-\d.*", args[i]):
                return None, f"{a} needs a value"
            seen.add(a)
            i += 1
        elif a in ("-J", "--job-name") or a.startswith("--job-name="):
            return None, "do not pass a job name: hpc-probe sets it to hpc-probe-NAME-<random>"
        elif a.startswith("-"):
            hint = " Write long options as --option=value." if sched == "slurm" else ""
            return None, f"unknown option {a!r}: hpc-probe accepts only options whose values it can tell apart.{hint}"
        else:
            return None, (f"{a!r} is not an option or an option's value. Give scheduler options only: hpc-probe adds "
                          f"the {WRAPPER[sched]} command itself")
        i += 1
    if "--job-name" in seen:
        return None, "do not pass a job name: hpc-probe sets it to hpc-probe-NAME-<random>"
    if sched == "lsf" and "-Is" not in seen:
        return None, "bsub needs -Is for an interactive shell"
    if sched == "slurm" and "--pty" not in seen:
        return None, "srun needs --pty for an interactive shell"
    if not seen & {"-W", "-t", "--time"}:
        return None, "set a short walltime (-W for bsub, --time for srun)"
    return sched, None


def cmd_start(name, timeout, argv):
    check_name(name)
    fd = lock(name)
    old = load(name)
    if has_session(name) or (old and old.get("status") != "stopped"):
        done(REFUSED, f"name {name} is in use. Pick a new name")
    sched, err = allocation(argv)
    if err:
        done(REFUSED, err)
    path = shutil.which(argv[0])
    if not path:
        done(REFUSED, f"{argv[0]} not found on PATH")
    wrapper = os.path.join(os.path.dirname(os.path.realpath(__file__)), WRAPPER[sched])
    if not (os.path.isfile(wrapper) and os.access(wrapper, os.X_OK)):
        done(REFUSED, f"{wrapper} is missing or not executable")
    token = secrets.token_hex(4)
    job_name = f"hpc-probe-{name}-{token}"
    name_opt = ["-J", job_name] if sched == "lsf" else [f"--job-name={job_name}"]
    cwd = os.getcwd()
    st = {"name": name, "token": token, "sched": sched, "argv": [path] + name_opt + argv[1:] + [wrapper],
          "cwd": cwd, "job_name": job_name, "owner": owner(),
          "context": {k: os.environ.get(k) for k in CONTEXT_VARS},
          "log_dir": os.path.join(STATE_DIR, "runs", f"{name}-{token}"), "login_host": socket.gethostname(),
          "status": "starting", "job_id": None, "host": None, "counter": 0, "pending": None, "session_id": None,
          "pane_id": None, "pane_pid": None, "created": time.strftime("%Y-%m-%d %H:%M:%S")}
    os.close(private_dir(st["log_dir"], create=True))
    save(st)
    env = {k: v for k, v in os.environ.items() if not secret_name(k)}
    dropped = sorted(k for k in os.environ if secret_name(k))
    drop_env(st)
    write_new(state_dir_fd(), name + ".json.env", json.dumps(env))
    if dropped:
        print(f"hpc-probe: {name}: not passed to the job (secret-looking names): {', '.join(dropped)}")
    # the launcher gets the absolute state path, never a setting from the tmux server's environment
    launch = " ".join(shlex.quote(x) for x in (sys.executable, os.path.abspath(__file__), "_launch", state_path(name)))
    r = tmux("new-session", "-d", "-P", "-F", "#{session_id} #{pane_id} #{pane_pid}", "-s", name, "-x", "250",
             "-y", "50", "-c", cwd, launch)
    ids = r.stdout.split()
    if r.returncode or len(ids) != 3:
        drop_env(st)
        st["status"] = "stopped"
        save(st)
        done(REFUSED, f"tmux new-session failed: {r.stderr.strip() or r.stdout.strip()}")
    st.update(session_id=ids[0], pane_id=ids[1], pane_pid=int(ids[2]))
    save(st)
    print(f"hpc-probe: {name}: submitted in tmux session {name} (pane {ids[1]}), waiting for the job's shell",
          flush=True)
    wait_ready(st, timeout)


def cmd_launch(path):
    """Runs inside the tmux session: the allocation command, then the end marker. Never a shell."""
    env_file = path + ".env"
    try:
        with open(path) as f:
            st = json.load(f)
        with open(env_file) as f:
            env = json.load(f)
    finally:
        try:
            os.unlink(env_file)
        except FileNotFoundError:
            pass
    for s in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP):
        signal.signal(s, signal.SIG_IGN)   # Ctrl-C belongs to the job, not to this launcher

    def child():
        for s in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP):
            signal.signal(s, signal.SIG_DFL)
    try:
        rc = subprocess.call(st["argv"], env=env, cwd=st["cwd"], preexec_fn=child)
    except OSError as e:
        print(f"hpc-probe launcher: {e}")
        rc = 127
    print(f"\n{marker(st, 'ALLOC_ENDED_')}{rc}", flush=True)
    time.sleep(600)   # keep the pane readable. Keys typed now go to nobody


def wait_ready(st, timeout):
    name = st["name"]
    ready_re = re.escape(marker(st, "READY_")) + r"(\d+)_(\S+)"
    probe = f'echo "{marker(st, "READY_")}${{LSB_JOBID:-${{SLURM_JOB_ID:-none}}}}_$(hostname)"'
    t_end, next_send, gap = time.time() + timeout, 0.0, RESEND
    while True:
        lines = pane(st)
        if lines is None:
            gone(st, "tmux session closed before the job started")
        hit, ended = scan(st, lines, ready_re)
        if hit:
            job, host = hit.group(1), hit.group(2)
            if short(host) == short(st["login_host"]):
                st["status"] = "refused"
                save(st)
                done(REFUSED, f"{name}: the shell reports host {host}, which is this login node. Sent no work. "
                              f"Run `hpc-probe stop {name}`")
            st.update(status="ready", job_id=job, host=host)
            save(st)
            print(f"name={name} job={job} host={host} sched={st['sched']} job_name={st['job_name']} "
                  f"log_dir={st['log_dir']}")
            done(OK, f"{name}: ready. Send commands with `hpc-probe run {name} -- '<cmd>'`")
        if ended is not None:
            gone(st, f"the allocation command exited with {ended} before the job's shell answered")
        if time.time() >= t_end:
            save(st)
            done(TIMEOUT, f"{name}: no job shell after {timeout:.0f} s (job name {st['job_name']}, probably still "
                          f"pending). Keep waiting with `hpc-probe wait {name}`, check the queue, or "
                          f"`hpc-probe stop {name}`")
        if time.time() >= next_send:
            send(st, probe)   # repeated echoes are harmless, and the answer does not depend on type-ahead
            next_send, gap = time.time() + gap, min(gap * 2, 120)
        time.sleep(POLL)


# ---------------------------------------------------------------- run, wait
def usable(name):
    check_name(name)
    st = load(name)
    if not st:
        done(REFUSED, f"no probe named {name}. Start one with `hpc-probe start {name} -- ...`")
    if st["status"] == "ended":
        done(GONE, f"{name} has ended. Run `hpc-probe stop {name}`, then start a new probe")
    if st["status"] in ("stopped", "refused", "changed"):
        done(CHANGED if st["status"] == "changed" else REFUSED, f"{name} is {st['status']}. Start a new probe")
    ensure(st)
    return st


def cmd_run(name, timeout, tail, argv):
    usable(name)
    fd = lock(name)
    st = load(name)
    if st["status"] != "ready":
        done(REFUSED, f"{name} is not ready ({st['status']}). Use `hpc-probe wait {name}`")
    if st.get("pending"):
        hit, _ = scan(st, pane(st) or [], re.escape(marker(st, f"{st['pending']}_END_")) + r"(\d+)")
        if not hit:
            done(REFUSED, f"{name}: command {st['pending']} has not ended. `hpc-probe wait {name}` or "
                          f"`hpc-probe stop {name}`")
        st["pending"] = None
    if not argv:
        done(REFUSED, "give the command after --")
    cmd = argv[0] if len(argv) == 1 else shlex.join(argv)
    if not cmd.strip():
        done(REFUSED, "the command is empty")
    n = st["counter"] + 1
    dfd = private_dir(st["log_dir"])
    write_new(dfd, f"{n}.sh", cmd.rstrip("\n") + "\n")
    write_new(dfd, f"{n}.log", "")
    st["counter"], st["pending"] = n, n
    save(st)
    script, log = (shlex.quote(os.path.join(st["log_dir"], f"{n}.{ext}")) for ext in ("sh", "log"))
    end = marker(st, f"{n}_END_")
    # As an `if` condition, `set -e` inside the command cannot end the shell. The options are reset afterwards.
    send(st, f'if {{ . {script} ; }} > {log} 2>&1 < /dev/null; then echo "{end}0"; else echo "{end}$?"; fi; '
             f'set +e +u +o pipefail; trap - ERR')
    wait_cmd(st, n, timeout, tail)


def wait_cmd(st, n, timeout, tail):
    name, t_end = st["name"], time.time() + timeout
    end_re = re.escape(marker(st, f"{n}_END_")) + r"(\d+)"
    while True:
        lines = pane(st)
        if lines is None:
            gone(st, "tmux session closed")
        hit, ended = scan(st, lines, end_re)
        if hit:
            rc = int(hit.group(1))
            st["pending"] = None
            save(st)
            text = read_private(private_dir(st["log_dir"]), f"{n}.log")
            out = ["(no log: can the job write to the probe folder?)"] if text is None else \
                (text.splitlines()[-tail:] if tail else [])
            print("\n".join(out))
            print(f"hpc-probe: {name}: command {n} exit {rc}, log {os.path.join(st['log_dir'], f'{n}.log')}",
                  flush=True)
            sys.exit(rc)
        if ended is not None:
            gone(st, f"the allocation ended with {ended} during command {n}")
        if time.time() >= t_end:
            log = os.path.join(st["log_dir"], f"{n}.log")
            done(TIMEOUT, f"{name}: command {n} still running after {timeout:.0f} s. Inspect `tail {log}` or "
                          f"`hpc-probe attach {name}`, then `hpc-probe wait {name}` or `hpc-probe stop {name}`. "
                          f"Work longer than {MAX_WAIT} s belongs in a batch job")
        time.sleep(POLL)


def cmd_wait(name, timeout, tail):
    usable(name)
    fd = lock(name)
    st = load(name)
    if st["status"] == "starting":
        wait_ready(st, timeout)
    if st.get("pending"):
        wait_cmd(st, st["pending"], timeout, tail)
    done(OK, f"{name}: nothing to wait for")


# ---------------------------------------------------------------- stop, attach
def job_lookup(st):
    """('gone' | 'running' | 'unknown', job id), by the probe's job name and owner. 'gone' only for an explicit
    ended state or no row at all. A row that does not parse or match, an unknown state, several rows or another
    scheduler setup than start's give 'unknown'."""
    sched, want = st["sched"], st.get("job_id")
    now = {k: os.environ.get(k) for k in CONTEXT_VARS}
    if st.get("context") is not None and now != st["context"]:
        print(f"hpc-probe: scheduler setup differs from start ({st['context']} then, {now} now)")
        return "unknown", None
    if sched == "lsf":
        cmd = ["bjobs", "-a", "-u", st["owner"], "-J", st["job_name"], "-noheader", "-o", "jobid job_name user stat"]
    else:
        cmd = ["squeue", "-h", "-u", st["owner"], "-n", st["job_name"], "-o", "%i %j %u %T"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown", None
    lines = [x for x in r.stdout.splitlines() if x.strip()]
    if not lines:
        err = r.stderr
        if sched == "lsf" and r.returncode and re.search(r"is not found|No (unfinished |matching )?job found", err):
            return "gone", None
        return ("gone", None) if sched == "slurm" and r.returncode == 0 else ("unknown", None)
    if r.returncode or len(lines) != 1:
        return "unknown", None
    f = lines[0].split()
    if len(f) != 4 or not f[0].isdigit() or f[1] != st["job_name"] or f[2] != st["owner"] or (want and f[0] != want):
        print(f"hpc-probe: cannot read the scheduler's row as this probe's job: {lines[0]!r}")
        return "unknown", None
    if f[3] in ENDED[sched]:
        return "gone", f[0]
    if f[3] in LIVE[sched]:
        return "running", f[0]
    print(f"hpc-probe: unknown job state {f[3]!r}")
    return "unknown", f[0]


def cmd_stop(name):
    check_name(name)
    fd = lock(name)
    st = load(name)
    if not st:
        done(REFUSED, f"no probe named {name}")
    if st["status"] == "stopped":
        done(OK, f"{name} is already stopped")
    ident = identity(st) if st.get("pane_id") else "gone"
    if ident == "changed":
        print(f"hpc-probe: {name}: the tmux session is no longer the one start created. Not touching it")
    if ident == "ok" and st["status"] == "ready":
        if st.get("pending"):
            tmux("send-keys", "-t", st["pane_id"], "C-c")
            time.sleep(2)
        send(st, "exit")
    t_end = time.time() + (STOP_GRACE if st["status"] == "ready" and ident == "ok" else 0)
    state, jid = job_lookup(st)
    while state != "gone" and time.time() < t_end:
        time.sleep(POLL)
        state, jid = job_lookup(st)
    if state == "running":
        state, jid = job_lookup(st)   # re-query right before the kill: name, owner and id must still match
        if state == "running" and jid:
            kill = ["bkill", jid] if st["sched"] == "lsf" else ["scancel", jid]
            r = subprocess.run(kill, capture_output=True, text=True)
            print(f"{' '.join(kill)}: {(r.stdout + r.stderr).strip()}")
            t_end = time.time() + 120
            while state != "gone" and time.time() < t_end:
                time.sleep(max(POLL, 1))
                state, jid = job_lookup(st)
    if state != "gone":
        save(st)
        done(NOT_CONFIRMED, f"{name}: the scheduler does not confirm that job {st['job_name']} has ended ({state}). "
                            f"The tmux pane and the probe stay. Keep monitoring and report")
    drop_env(st)
    if st.get("pane_id") and identity(st) == "ok":
        panes = tmux("list-panes", "-s", "-t", st["session_id"], "-F", "#{pane_id}").stdout.split()
        if panes == [st["pane_id"]]:
            tmux("kill-session", "-t", st["session_id"])
        else:
            tmux("kill-pane", "-t", st["pane_id"])   # someone added panes: close only the probe's own
    st["status"] = "stopped"
    save(st)
    done(OK, f"{name}: job {st['job_name']} is gone and the probe's tmux pane is closed"
             + (" (the replacement session was left alone)" if ident == "changed" else ""))


def cmd_attach(name):
    st = usable(name)
    print(" ".join(shlex.quote(x) for x in TMUX + ["attach", "-r", "-t", st["session_id"]]))
    done(OK, "read-only (-r). Detach with Ctrl-b d")


# ---------------------------------------------------------------- main
def main(args):
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0 if args else REFUSED)
    action, rest = args[0], args[1:]
    if action == "_launch":
        return cmd_launch(rest[0])
    if not rest:
        done(REFUSED, f"{action}: give a probe name")
    name, rest = rest[0], rest[1:]
    opts, argv = rest, []
    if "--" in rest:
        i = rest.index("--")
        opts, argv = rest[:i], rest[i + 1:]
    timeout, tail = float(MAX_WAIT), 20
    it = iter(opts)
    for o in it:
        try:
            if o == "--timeout":
                timeout = bounded(float(next(it)))
            elif o == "--tail":
                tail = int(next(it))
                if tail < 0:
                    done(REFUSED, "--tail must be 0 or more")
            else:
                done(REFUSED, f"unknown option {o!r}")
        except (StopIteration, ValueError):
            done(REFUSED, f"{o} needs a number")
    if action == "start":
        cmd_start(name, timeout, argv)
    elif action == "run":
        cmd_run(name, timeout, tail, argv)
    elif action == "wait":
        cmd_wait(name, timeout, tail)
    elif action == "stop":
        cmd_stop(name)
    elif action == "attach":
        cmd_attach(name)
    else:
        done(REFUSED, f"unknown action {action!r}. See --help")


if __name__ == "__main__":
    main(sys.argv[1:])
