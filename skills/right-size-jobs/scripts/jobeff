#!/usr/bin/env python3
"""jobeff: CPU and memory efficiency of cluster jobs, with a suggested next request.

Usage:
  jobeff JOBID [JOBID ...]          LSF: bjobs -a -json, falling back to bacct -l for old jobs
  jobeff --user                     LSF: your jobs still known to bjobs -a
  jobeff --lsf-log FILE [FILE ...]  LSF .out files with a "Resource usage summary" (works offline)
  jobeff --slurm JOBID [...]        SLURM: sacct
  jobeff --slurm --user             SLURM: your jobs from the last 2 days
  jobeff --bjobs-json FILE          parse saved `bjobs -o ... -json` output (testing)
Options: --tsv for tab-separated output.

Suggestion rules: cores = cores actually used, rounded up from x.25 and capped at the allocation, memory = 1.3 x peak rounded up to 500 MB,
walltime = 1.5 x run time (use the p95 over many runs when you have them).
Flags: RUNNING (values so far, so -M and -W are floors), LOW_CPU (eff < 0.5), MEM_OVER (peak/req < 0.4), MEM_NEAR (> 0.95), IDLE (idle factor < 0.25), FAILED.
A job killed at its memory limit shows MEM_NEAR: its true peak is unknown, so the -M suggestion is a floor.
"""
import json
import math
import re
import signal
import subprocess
import sys

BJOBS_FIELDS = "jobid jobindex stat queue slots cpu_used run_time max_mem memlimit idle_factor exit_code"
UNIT_MB = {"": 1.0, "k": 1 / 1024, "m": 1.0, "g": 1024.0, "t": 1024.0 ** 2}


def mem_mb(text, default_unit="m"):
    """'1.2 Gbytes', '7578 MB', '8 G', '4000M', '30.0G' -> MB. None if absent."""
    if text is None:
        return None
    m = re.search(r"([\d.]+)\s*([kKmMgGtT]?)", str(text))
    if not m or m.group(1) in ("", "."):
        return None
    unit = (m.group(2) or default_unit).lower()
    return float(m.group(1)) * UNIT_MB[unit]


def seconds(text):
    """'5321.0 second(s)', '3600 sec.', '1-02:03:04', '02:03:04', '03:04.5' -> seconds."""
    if text is None or str(text).strip() in ("", "-"):
        return None
    t = str(text).strip()
    m = re.match(r"^([\d.]+)\s*(second|sec|s\b)", t)
    if m:
        return float(m.group(1))
    days = 0
    if "-" in t:
        d, t = t.split("-", 1)
        days = int(d)
    parts = [float(p) for p in t.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0.0)
    h, mi, s = parts[-3:]
    return days * 86400 + h * 3600 + mi * 60 + s


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=120).stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        sys.exit(f"jobeff: could not run {cmd[0]}: {e}")


# ---------- LSF ----------
def from_bjobs_json(text):
    out = []
    for r in json.loads(text).get("RECORDS", []):
        if "ERROR" in r:
            out.append({"id": r.get("JOBID", "?"), "error": r["ERROR"]})
            continue
        idx = str(r.get("JOBINDEX") or "0")
        out.append({
            "id": r.get("JOBID") + (f"[{idx}]" if idx not in ("0", "-") else ""), "state": r.get("STAT"),
            "cores": int(r.get("SLOTS") or 1),
            "cpu_s": seconds(r.get("CPU_USED")), "wall_s": seconds(r.get("RUN_TIME")),
            "peak_mb": mem_mb(r.get("MAX_MEM")), "req_mb": mem_mb(r.get("MEMLIMIT")),
            "idle": float(r["IDLE_FACTOR"]) if re.match(r"^[\d.]+$", str(r.get("IDLE_FACTOR", ""))) else None,
            "exit": r.get("EXIT_CODE") or "",
        })
    return out


def from_bacct(jobid):
    text = run(["bacct", "-l", str(jobid)])
    m = re.search(r"CPU_T\s+WAIT\s+TURNAROUND\s+STATUS\s+HOG_FACTOR\s+MEM\s+SWAP\s*\n\s*"
                  r"([\d.]+)\s+(\d+)\s+(\d+)\s+(\w+)\s+[\d.]+\s+(\S+)", text)
    if not m:
        return {"id": jobid, "error": "not found by bjobs or bacct"}
    cores = re.search(r"Dispatched\s+(\d+)\s+Task", text) or re.search(r"(\d+)\s+(?:Task|Processor)", text)
    req = re.search(r"MEMLIMIT\s*\n\s*([\d.]+\s*[KMGT]?)", text)
    return {"id": jobid, "state": m.group(4).upper(), "cores": int(cores.group(1)) if cores else 1,
            "cpu_s": float(m.group(1)), "wall_s": float(m.group(3)) - float(m.group(2)),
            "peak_mb": mem_mb(m.group(5)), "req_mb": mem_mb(req.group(1)) if req else None,
            "idle": None, "exit": ""}


def lsf_jobs(ids, user):
    cmd = ["bjobs", "-a", "-o", BJOBS_FIELDS, "-json"] + ([] if user else [str(i) for i in ids])
    rows = from_bjobs_json(run(cmd) or '{"RECORDS": []}')
    return [from_bacct(r["id"]) if "error" in r else r for r in rows]


def from_lsf_log(path):
    with open(path, errors="replace") as fh:
        text = fh.read()
    blocks = text.split("Resource usage summary:")
    if len(blocks) < 2:
        return {"id": path, "error": "no Resource usage summary"}
    head, summ = blocks[-2], blocks[-1]

    def field(name):
        m = re.search(name + r"\s*:\s*([^\n]+)", summ)
        return m.group(1).strip() if m else None
    jid = re.search(r"Subject: Job (\d+(?:\[\d+\])?)", head) or re.search(r"Job <?(\d+(?:\[\d+\])?)>?", head)
    hosts = re.search(r"executed on host\(s\) <([^>]*)>", head)
    cores = 1
    if hosts:
        cores = sum(int(h.split("*")[0]) if "*" in h else 1 for h in re.findall(r"[\w*.-]+", hosts.group(1)))
        extra = re.findall(r"^\s+<(\d+)\*[^>]+>", head, re.M)  # continuation lines for multi-host jobs
        cores += sum(int(x) for x in extra)
    state = "DONE" if "Successfully completed." in head else "EXIT"
    exitm = re.search(r"Exited with exit code (\d+)", head)
    reason = re.search(r"TERM_\w+", head)
    peak = field("Max Memory")
    return {"id": jid.group(1) if jid else path, "state": state, "cores": cores,
            "cpu_s": seconds(field("CPU time")), "wall_s": seconds(field("Run time")),
            "peak_mb": None if peak in (None, "-") else mem_mb(peak),
            "req_mb": mem_mb(field("Total Requested Memory")), "idle": None,
            "exit": (exitm.group(1) if exitm else "") + ((" " + reason.group(0)) if reason else "")}


# ---------- SLURM ----------
def slurm_jobs(ids, user):
    fmt = "JobID,State,Elapsed,TotalCPU,AllocCPUS,ReqMem,MaxRSS,ExitCode"
    cmd = ["sacct", "-n", "-P", "-o", fmt]
    cmd += ["-u", subprocess.getoutput("id -un"), "-S", "now-2days"] if user else ["-j", ",".join(map(str, ids))]
    jobs = {}
    for line in run(cmd).splitlines():
        f = line.split("|")
        if len(f) < 8:
            continue
        base = f[0].split(".")[0]
        j = jobs.setdefault(base, {"id": base, "peak_mb": None, "cpu_s": 0.0, "idle": None})
        rss = mem_mb(f[6], "k") if f[6] else None  # sacct MaxRSS without unit is in KB
        if rss is not None:
            j["peak_mb"] = max(j["peak_mb"] or 0.0, rss)
        if "." not in f[0]:
            cores = int(f[4] or 1)
            req = f[5]
            req_mb = mem_mb(req)
            if req_mb is not None and req.endswith("c"):
                req_mb *= cores
            j.update(state=f[1].split()[0], wall_s=seconds(f[2]), cpu_s=seconds(f[3]) or 0.0,
                     cores=cores, req_mb=req_mb, exit=f[7])
    return [j for j in jobs.values() if "state" in j]


# ---------- report ----------
def analyse(j):
    flags, sug = [], {}
    cores, cpu, wall = j.get("cores") or 1, j.get("cpu_s"), j.get("wall_s")
    eff = cpu / (wall * cores) if cpu is not None and wall else None
    if eff is not None:
        if eff < 0.5:
            flags.append("LOW_CPU")
        sug["n"] = min(cores, max(1, round(cpu / wall + 0.25)))
    peak, req = j.get("peak_mb"), j.get("req_mb")
    ratio = peak / req if peak and req else None
    if ratio is not None and ratio < 0.4:
        flags.append("MEM_OVER")
    if ratio is not None and ratio > 0.95:
        flags.append("MEM_NEAR")
    if peak:
        sug["M"] = int(math.ceil(peak * 1.3 / 500.0) * 500)
    running = (j.get("state") or "").upper() in ("RUN", "RUNNING", "PEND", "PENDING")
    if running:
        flags.append("RUNNING")  # peak and run time so far: -M and -W are floors, not final values
    if wall:
        mins = math.ceil(wall * 1.5 / 60.0)
        sug["W"] = f"{mins // 60}:{mins % 60:02d}"
    if j.get("idle") is not None and j["idle"] < 0.25:
        flags.append("IDLE")
    state = (j.get("state") or "").upper()
    if state in ("EXIT", "FAILED", "OUT_OF_MEMORY", "TIMEOUT", "CANCELLED") or "TERM_" in str(j.get("exit")):
        flags.append("FAILED")
    return eff, ratio, sug, flags


def fmt_mb(x):
    return "-" if x is None else (f"{x / 1024:.1f}G" if x >= 1024 else f"{x:.0f}M")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    tsv = "--tsv" in argv
    argv = [a for a in argv if a != "--tsv"]
    if argv[0] == "--lsf-log":
        jobs = [from_lsf_log(p) for p in argv[1:]]
    elif argv[0] == "--bjobs-json":
        with open(argv[1]) as fh:
            jobs = from_bjobs_json(fh.read())
    elif argv[0] == "--slurm":
        jobs = slurm_jobs(argv[1:], "--user" in argv[1:])
    else:
        jobs = lsf_jobs(argv, argv[0] == "--user")
    cols = ["job", "state", "cores", "cpu_eff", "peak", "req", "peak/req", "run", "suggest", "flags"]
    rows = []
    for j in jobs:
        if "error" in j:
            rows.append([str(j["id"]), "?", "", "", "", "", "", "", "", j["error"]])
            continue
        eff, ratio, sug, flags = analyse(j)
        wall = j.get("wall_s")
        rows.append([str(j["id"]), j.get("state") or "", str(j.get("cores") or ""),
                     "-" if eff is None else f"{eff:.2f}", fmt_mb(j.get("peak_mb")), fmt_mb(j.get("req_mb")),
                     "-" if ratio is None else f"{ratio:.2f}",
                     "-" if wall is None else f"{wall / 3600:.2f}h",
                     " ".join(f"-{k} {v}" for k, v in sug.items()), ",".join(flags)])
    if tsv:
        print("\t".join(cols))
        for r in rows:
            print("\t".join(r))
    else:
        w = [max(len(c), *(len(r[i]) for r in rows)) if rows else len(c) for i, c in enumerate(cols)]
        for r in [cols] + rows:
            print("  ".join(x.ljust(w[i]) for i, x in enumerate(r)).rstrip())
    return 0


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # quiet exit when piped into head
    sys.exit(main(sys.argv[1:]))
